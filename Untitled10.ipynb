      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab-dark colab-dark" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;Cell&nbsp;45:&nbsp;Random&nbsp;Forest&nbsp;baseline</span></span><br><span><span></span></span><br><span><span class="mtk20">from</span><span class="mtk1">&nbsp;sklearn.ensemble&nbsp;</span><span class="mtk20">import</span><span class="mtk1">&nbsp;RandomForestClassifier</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Use&nbsp;the&nbsp;scaled&nbsp;feature&nbsp;data&nbsp;already&nbsp;prepared</span></span><br><span><span class="mtk1">X_train_rf&nbsp;=&nbsp;X_train.squeeze</span><span class="mtk14">(</span><span class="mtk6">1</span><span class="mtk14">)</span><span class="mtk1">.numpy</span><span class="mtk14">()</span></span><br><span><span class="mtk1">X_test_rf&nbsp;=&nbsp;X_test.squeeze</span><span class="mtk14">(</span><span class="mtk6">1</span><span class="mtk14">)</span><span class="mtk1">.numpy</span><span class="mtk14">()</span></span><br><span><span></span></span><br><span><span class="mtk1">y_train_rf&nbsp;=&nbsp;y_train.numpy</span><span class="mtk14">()</span></span><br><span><span class="mtk1">y_test_rf&nbsp;=&nbsp;y_test.numpy</span><span class="mtk14">()</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_model&nbsp;=&nbsp;RandomForestClassifier</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;n_estimators=</span><span class="mtk6">200</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;max_depth=</span><span class="mtk6">10</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;random_state=</span><span class="mtk6">42</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;n_jobs=</span><span class="mtk6">-1</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_model.fit</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X_train_rf</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_train_rf</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_predictions&nbsp;=&nbsp;rf_model.predict</span><span class="mtk14">(</span><span class="mtk1">X_test_rf</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_probabilities&nbsp;=&nbsp;rf_model.predict_proba</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X_test_rf</span></span><br><span><span class="mtk14">)[:,</span><span class="mtk1">&nbsp;</span><span class="mtk6">1</span><span class="mtk14">]</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_accuracy&nbsp;=&nbsp;accuracy_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_test_rf</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;rf_predictions</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_precision&nbsp;=&nbsp;precision_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_test_rf</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;rf_predictions</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;zero_division=</span><span class="mtk6">0</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_recall&nbsp;=&nbsp;recall_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_test_rf</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;rf_predictions</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;zero_division=</span><span class="mtk6">0</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_f1&nbsp;=&nbsp;f1_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_test_rf</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;rf_predictions</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;zero_division=</span><span class="mtk6">0</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_auc&nbsp;=&nbsp;roc_auc_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_test_rf</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;rf_probabilities</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_cm&nbsp;=&nbsp;confusion_matrix</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_test_rf</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;rf_predictions</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"="</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk6">50</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"RANDOM&nbsp;FOREST&nbsp;TEST&nbsp;RESULTS"</span><span class