      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab-dark colab-dark" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;================================================</span><span class="mtk8">============</span></span><br><span><span class="mtk8">#&nbsp;28.&nbsp;CREATE&nbsp;TRAIN&nbsp;/&nbsp;VALIDATION&nbsp;SPLIT</span></span><br><span><span class="mtk8">#&nbsp;================================================</span><span class="mtk8">============</span></span><br><span><span></span></span><br><span><span class="mtk20">from</span><span class="mtk1">&nbsp;sklearn.model_selection&nbsp;</span><span class="mtk20">import</span><span class="mtk1">&nbsp;train_test_split</span></span><br><span><span class="mtk20">from</span><span class="mtk1">&nbsp;torch.utils.data&nbsp;</span><span class="mtk20">import</span><span class="mtk1">&nbsp;TensorDataset</span><span class="mtk14">,</span><span class="mtk1">&nbsp;DataLoader</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Remove&nbsp;CNN&nbsp;channel&nbsp;dimension</span></span><br><span><span class="mtk1">X_all&nbsp;=&nbsp;X_train.squeeze</span><span class="mtk14">(</span><span class="mtk6">1</span><span class="mtk14">)</span></span><br><span><span class="mtk1">y_all&nbsp;=&nbsp;y_train</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Split&nbsp;training&nbsp;data</span></span><br><span><span class="mtk1">X_tr</span><span class="mtk14">,</span><span class="mtk1">&nbsp;X_val</span><span class="mtk14">,</span><span class="mtk1">&nbsp;y_tr</span><span class="mtk14">,</span><span class="mtk1">&nbsp;y_val&nbsp;=&nbsp;train_test_split</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X_all</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_all</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;test_size=</span><span class="mtk6">0.20</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;random_state=</span><span class="mtk6">42</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;stratify=y_all.numpy</span><span class="mtk14">()</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Add&nbsp;CNN&nbsp;channel&nbsp;dimension&nbsp;again</span></span><br><span><span class="mtk1">X_tr&nbsp;=&nbsp;X_tr.unsqueeze</span><span class="mtk14">(</span><span class="mtk6">1</span><span class="mtk14">)</span></span><br><span><span class="mtk1">X_val&nbsp;=&nbsp;X_val.unsqueeze</span><span class="mtk14">(</span><span class="mtk6">1</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Create&nbsp;datasets</span></span><br><span><span class="mtk1">train_dataset_new&nbsp;=&nbsp;TensorDataset</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X_tr</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_tr</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">val_dataset_new&nbsp;=&nbsp;TensorDataset</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X_val</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_val</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Create&nbsp;loaders</span></span><br><span><span class="mtk1">train_loader_new&nbsp;=&nbsp;DataLoader</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;train_dataset_new</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;batch_size=</span><span class="mtk6">64</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;shuffle=</span><span class="mtk9">True</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">val_loader_new&nbsp;=&nbsp;DataLoader</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;val_dataset_new</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;batch_size=</span><span class="mtk6">64</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;shuffle=</span><span class="mtk9">False</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"=============================="</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"NEW&nbsp;DATA&nbsp;SPLIT"</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"=============================="</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"Training&nbsp;samples&nbsp;&nbsp;:"</span><span class="mtk14">,</span><span class="mtk1">&nbsp;</span><span class="mtk17">len</span><span class="mtk14">(</span><span class="mtk1">train_dataset_new</span><span class="mtk14">))</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"Validation&nbsp;samples:"</span><span class="mtk14">,</span><span class="mtk1">&nbsp;</span><span class="mtk17">len</span><span class="mtk14">(</span><span class="mtk1">val_dataset_new</span><span class="mtk14">))</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"Test&nbsp;samples&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:"</span><span class="mtk14">,</span><span class="mtk1">&nbsp;</span><span class="mtk17">len</span><span class="mtk14">(</span><span class="mtk1">test_dataset</span><span class="mtk14">))</span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"\nInput&nbsp;shape:"</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"Training:"</span><span class="mtk14">,</span><span class="mtk1">&nbsp;X_tr.shape</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"Validation:"</span><span class="mtk14">,</span><span class="mtk1">&nbsp;X_val.shape</span><span class="mtk14">)</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowrootmode="open"><!----><div><!--?lit$807402273$-->Start coding or <span tabindex="0" role="button" class="link">generate</span> with AI.</div></template></colab-read-only-cell-placeholder></pre></div><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>
