tk1">&nbsp;categorical_columns</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;One-hot&nbsp;encode&nbsp;categorical&nbsp;variables</span></span><br><span><span class="mtk20">if</span><span class="mtk1">&nbsp;</span><span class="mtk17">len</span><span class="mtk14">(</span><span class="mtk1">categorical_columns</span><span class="mtk14">)</span><span class="mtk1">&nbsp;&gt;&nbsp;</span><span class="mtk6">0</span><span class="mtk14">:</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X&nbsp;=&nbsp;pd.get_dummies</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;X</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;columns=categorical_columns</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;drop_first=</span><span class="mtk9">False</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Convert&nbsp;everything&nbsp;to&nbsp;numeric</span></span><br><span><span class="mtk1">X&nbsp;=&nbsp;X.apply</span><span class="mtk14">(</span><span class="mtk1">pd.to_numeric</span><span class="mtk14">,</span><span class="mtk1">&nbsp;errors=</span><span class="mtk5">"coerce"</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">X&nbsp;=&nbsp;X.fillna</span><span class="mtk14">(</span><span class="mtk1">X.median</span><span class="mtk14">(</span><span class="mtk1">numeric_only=</span><span class="mtk9">True</span><span class="mtk14">))</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Any&nbsp;remaining&nbsp;missing&nbsp;values</span></span><br><span><span class="mtk1">X&nbsp;=&nbsp;X.fillna</span><span class="mtk14">(</span><span class="mtk6">0</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"\nNumber&nbsp;of&nbsp;final&nbsp;features:"</span><span class="mtk14">,</span><span class="mtk1">&nbsp;X.shape</span><span class="mtk14">[</span><span class="mtk6">1</span><span class="mtk14">])</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowrootmode="open"><!----><div><!--?lit$807402273$-->Start coding or <span tabindex="0" role="button" class="link">generate</span> with AI.</div></template></colab-read-only-cell-placeholder></pre></div><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>
