      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab-dark colab-dark colab-dark colab-dark colab-dark colab-dark" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;Cell&nbsp;51:&nbsp;Save&nbsp;trained&nbsp;models</span></span><br><span><span></span></span><br><span><span class="mtk20">import</span><span class="mtk1">&nbsp;os</span></span><br><span><span class="mtk20">import</span><span class="mtk1">&nbsp;joblib</span></span><br><span><span class="mtk20">import</span><span class="mtk1">&nbsp;torch</span></span><br><span><span></span></span><br><span><span class="mtk1">os.makedirs</span><span class="mtk14">(</span><span class="mtk5">"models"</span><span class="mtk14">,</span><span class="mtk1">&nbsp;exist_ok=</span><span class="mtk9">True</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Save&nbsp;CNN</span></span><br><span><span class="mtk1">torch.save</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;cnn_model.state_dict</span><span class="mtk14">(),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"models/cnn_model.pth"</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Save&nbsp;CNN&nbsp;+&nbsp;Self-Attention</span></span><br><span><span class="mtk1">torch.save</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;attention_model.state_dict</span><span class="mtk14">(),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"models/cnn_attention_model.pth"</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Save&nbsp;Random&nbsp;Forest</span></span><br><span><span class="mtk1">joblib.dump</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;rf_model</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"models/random_forest_model.pkl"</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Save&nbsp;scaler</span></span><br><span><span class="mtk1">joblib.dump</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;scaler</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk5">"models/scaler.pkl"</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"Models&nbsp;saved&nbsp;successfully!"</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"\nSaved&nbsp;files:"</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk20">for</span><span class="mtk1">&nbsp;</span><span class="mtk4">file</span><span class="mtk1">&nbsp;</span><span class="mtk19">in</span><span class="mtk1">&nbsp;os.listdir</span><span class="mtk14">(</span><span class="mtk5">"models"</span><span class="mtk14">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"&nbsp;-"</span><span class="mtk14">,</span><span class="mtk1">&nbsp;</span><span class="mtk4">file</span><span class="mtk14">)</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowrootmode="open"><!----><div><!--?lit$807402273$-->Start coding or <span tabindex="0" role="button" class="link">generate</span> with AI.</div></template></cola