      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab-dark colab-dark" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;Cell&nbsp;38:&nbsp;Create&nbsp;DataLoaders&nbsp;for&nbsp;the&nbsp;improved&nbsp;dat</span><span class="mtk8">aset</span></span><br><span><span></span></span><br><span><span class="mtk20">from</span><span class="mtk1">&nbsp;torch.utils.data&nbsp;</span><span class="mtk20">import</span><span class="mtk1">&nbsp;TensorDataset</span><span class="mtk14">,</span><span class="mtk1">&nbsp;DataLoader</span></span><br><span><span></span></span><br><span><span class="mtk1">BATCH_SIZE&nbsp;=&nbsp;</span><span class="mtk6">32</span></span><br><span><span></span></span><br><span><span class="mtk1">train_dataset&nbsp;=&nbsp;TensorDataset</span><span class="mtk14">(</span><span class="mtk1">X_train</span><span class="mtk14">,</span><span class="mtk1">&nbsp;y_train</span><span class="mtk14">)</span></span><br><span><span class="mtk1">test_dataset&nbsp;=&nbsp;TensorDataset</span><span class="mtk14">(</span><span class="mtk1">X_test</span><span class="mtk14">,</span><span class="mtk1">&nbsp;y_test</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">train_loader&nbsp;=&nbsp;DataLoader</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;train_dataset</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;batch_size=BATCH_SIZE</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;shuffle=</span><span class="mtk9">True</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">test_loader&nbsp;=&nbsp;DataLoader</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbs