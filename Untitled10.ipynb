lass="mtk14">]</span></span><br><span><span></span></span><br><span><span class="mtk1">x&nbsp;=&nbsp;np.arange</span><span class="mtk14">(</span><span class="mtk17">len</span><span class="mtk14">(</span><span class="mtk1">models</span><span class="mtk14">))</span></span><br><span><span class="mtk1">width&nbsp;=&nbsp;</span><span class="mtk6">0.15</span></span><br><span><span></span></span><br><span><span class="mtk1">plt.figure</span><span class="mtk14">(</span><span class="mtk1">figsize=</span><span class="mtk14">(</span><span class="mtk6">14</span><span class="mtk14">,</span><span class="mtk1">&nbsp;</span><span class="mtk6">7</span><span class="mtk14">))</span></span><br><span><span></span></span><br><span><span class="mtk20">for</span><span class="mtk1">&nbsp;i</span><span class="mtk14">,</span><span class="mtk1">&nbsp;metric&nbsp;</span><span class="mtk19">in</span><span class="mtk1">&nbsp;</span><span class="mtk17">enumerate</span><span class="mtk14">(</span><span class="mtk1">metrics</span><span class="mtk14">):</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;values&nbsp;=&nbsp;comparison</span><span class="mtk14">[</span><span class="mtk1">metric</span><span class="mtk14">]</span><span class="mtk1">.values</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;bars&nbsp;=&nbsp;plt.bar</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;x&nbsp;+&nbsp;</span><span class="mtk14">(</span><span class="mtk1">i&nbsp;-&nbsp;</span><span class="mtk6">2</span><span class="mtk14">)</span><span class="mtk1">&nbsp;*&nbsp;width</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;values</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;width</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;label=metric</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;Add&nbsp;values&nbsp;above&nbsp;bars</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk20">for</span><span class="mtk1">&nbsp;bar</span><span class="mtk14">,</span><span class="mtk1">&nbsp;value&nbsp;</span><span class="mtk19">in</span><span class="mtk1">&nbsp;</span><span class="mtk17">zip</span><span class="mtk14">(</span><span class="mtk1">bars</span><span class="mtk14">,</span><span class="mtk1">&nbsp;values</span><span class="mtk14">):</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;plt.text</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;bar.get_x</span><span class="mtk14">()</span><span class="mtk1">&nbsp;+&nbsp;bar.get_width</span><span class="mtk14">()</span><span class="mtk1">&nbsp;/&nbsp;</span><span class="mtk6">2</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;value&nbsp;+&nbsp;</span><span class="mtk6">0.02</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk10">f</span><span class="mtk5">"</span><span class="mtk14">{</span><span class="mtk1">value</span><span class="mtk6">:.2f</span><span class="mtk14">}</span><span class="mtk5">"</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;ha=</span><span class="mtk5">"center"</span><span class="mtk14">,</span></spa