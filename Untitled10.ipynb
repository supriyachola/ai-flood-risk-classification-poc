      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab-dark colab-dark colab-dark" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;================================================</span><span class="mtk8">============</span></span><br><span><span class="mtk8">#&nbsp;19.&nbsp;RANDOM&nbsp;FOREST&nbsp;BASELINE</span></span><br><span><span class="mtk8">#&nbsp;================================================</span><span class="mtk8">============</span></span><br><span><span></span></span><br><span><span class="mtk20">from</span><span class="mtk1">&nbsp;sklearn.ensemble&nbsp;</span><span class="mtk20">import</span><span class="mtk1">&nbsp;RandomForestClassifier</span></span><br><span><span class="mtk20">from</span><span class="mtk1">&nbsp;sklearn.metrics&nbsp;</span><span class="mtk20">import</span><span class="mtk1">&nbsp;</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;accuracy_score</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;precision_score</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;recall_score</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;f1_score</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;roc_auc_score</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Convert&nbsp;tensors&nbsp;to&nbsp;NumPy</span></span><br><span><span class="mtk1">X_train_rf&nbsp;=&nbsp;X_train.squeeze</span><span class="mtk14">(</span><span class="mtk6">1</span><span class="mtk14">)</span><span class="mtk1">.numpy</span><span class="mtk14">()</span></span><br><span><span class="mtk1">X_test_rf&nbsp;=&nbsp;X_test.squeeze</span><span class="mtk14">(</span><span class="mtk6">1</span><span class="mtk14">)</span><span class="mtk1">.numpy</span><span class="mtk14">()</span></span><br><span><span></span></span><br><span><span class="mtk1">y_train_rf&nbsp;=&nbsp;y_train.numpy</span><span class="mtk14">()</span><span class="mtk1">.astype</span><span class="mtk14">(</span><span class="mtk16">int</span><span class="mtk14">)</span></span><br><span><span class="mtk1">y_test_rf&nbsp;=&nbsp;y_test.numpy</span><span class="mtk14">()</span><span class="mtk1">.astype</span><span class="mtk14">(</span><span class="mtk16">int</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Create&nbsp;Random&nbsp;Forest</span></span><br><span><span class="mtk1">rf_model&nbsp;=&nbsp;RandomForestClassifier</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;n_estimators=</span><span class="mtk6">100</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;random_state=</span><span class="mtk6">42</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;n_jobs=</span><span class="mtk6">-1</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"Training&nbsp;Random&nbsp;Forest..."</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_model.fit</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X_train_rf</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_train_rf</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"Random&nbsp;Forest&nbsp;training&nbsp;completed!"</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Predictions</span></span><br><span><span class="mtk1">rf_predictions&nbsp;=&nbsp;rf_model.predict</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X_test_rf</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_probabilities&nbsp;=&nbsp;rf_model.predict_proba</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;X_test_rf</span></span><br><span><span class="mtk14">)[:,</span><span class="mtk1">&nbsp;</span><span class="mtk6">1</span><span class="mtk14">]</span></span><br><span><span></span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Evaluation</span></span><br><span><span class="mtk1">rf_accuracy&nbsp;=&nbsp;accuracy_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_test_rf</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;rf_predictions</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_precision&nbsp;=&nbsp;precision_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_test_rf</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;rf_predictions</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;zero_division=</span><span class="mtk6">0</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">rf_recall&nbsp;=&nbsp;recall_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;y_test_rf</span><span class="mtk14">,<