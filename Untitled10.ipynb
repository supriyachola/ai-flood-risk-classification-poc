      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab-dark colab-dark" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;Cell&nbsp;41:&nbsp;Evaluate&nbsp;CNN&nbsp;on&nbsp;the&nbsp;test&nbsp;set</span></span><br><span><span></span></span><br><span><span class="mtk20">from</span><span class="mtk1">&nbsp;sklearn.metrics&nbsp;</span><span class="mtk20">import</span><span class="mtk1">&nbsp;</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;accuracy_score</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;precision_score</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;recall_score</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;f1_score</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;roc_auc_score</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;confusion_matrix</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">cnn_model.</span><span class="mtk17">eval</span><span class="mtk14">()</span></span><br><span><span></span></span><br><span><span class="mtk1">all_predictions&nbsp;=&nbsp;</span><span class="mtk14">[]</span></span><br><span><span class="mtk1">all_probabilities&nbsp;=&nbsp;</span><span class="mtk14">[]</span></span><br><span><span class="mtk1">all_targets&nbsp;=&nbsp;</span><span class="mtk14">[]</span></span><br><span><span></span></span><br><span><span class="mtk20">with</span><span class="mtk1">&nbsp;torch.no_grad</span><span class="mtk14">():</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk20">for</span><span class="mtk1">&nbsp;batch_X</span><span class="mtk14">,</span><span class="mtk1">&nbsp;batch_y&nbsp;</span><span class="mtk19">in</span><span class="mtk1">&nbsp;test_loader</span><span class="mtk14">:</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;outputs&nbsp;=&nbsp;cnn_model</span><span class="mtk14">(</span><span class="mtk1">batch_X</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;probabilities&nbsp;=&nbsp;torch.sigmoid</span><span class="mtk14">(</span><span class="mtk1">outputs</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;predictions&nbsp;=&nbsp;</span><span class="mtk14">(</span><span class="mtk1">probabilities&nbsp;&gt;=&nbsp;</span><span class="mtk6">0.5</span><span class="mtk14">)</span><span class="mtk1">.</span><span class="mtk16">float</span><span class="mtk14">()</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;all_probabilities.extend</span><span class="mtk14">(</span><span class="mtk1">probabilities.cpu</span><span class="mtk14">()</span><span class="mtk1">.numpy</span><span class="mtk14">())</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;all_predictions.extend</span><span class="mtk14">(</span><span class="mtk1">predictions.cpu</span><span class="mtk14">()</span><span class="mtk1">.numpy</span><span class="mtk14">())</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;all_targets.extend</span><span class="mtk14">(</span><span class="mtk1">batch_y.cpu</span><span class="mtk14">()</span><span class="mtk1">.numpy</span><span class="mtk14">())</span></span><br><span><span></span></span><br><span><span></span></span><br><span><span class="mtk1">cnn_accuracy&nbsp;=&nbsp;accuracy_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_targets</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_predictions</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">cnn_precision&nbsp;=&nbsp;precision_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_targets</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_predictions</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;zero_division=</span><span class="mtk6">0</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">cnn_recall&nbsp;=&nbsp;recall_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_targets</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_predictions</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;zero_division=</span><span class="mtk6">0</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">cnn_f1&nbsp;=&nbsp;f1_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_targets</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_predictions</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;zero_division=</span><span class="mtk6">0</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">cnn_auc&nbsp;=&nbsp;roc_auc_score</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_targets</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_probabilities</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">cnn_cm&nbsp;=&nbsp;confusion_matrix</span><span class="mtk14">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_targets</span><span class="mtk14">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;all_predictions</span></span><br><span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"="</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk6">50</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"CNN&nbsp;TEST&nbsp;RESULTS"</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"="</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk6">50</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk10">f</span><span class="mtk5">"Accuracy&nbsp;:&nbsp;</span><span class="mtk14">{</span><span class="mtk1">cnn_accuracy</span><span class="mtk6">:.4f</span><span class="mtk14">}</span><span class="mtk5">"</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk10">f</span><span class="mtk5">"Precision:&nbsp;</span><span class="mtk14">{</span><span class="mtk1">cnn_precision</span><span class="mtk6">:.4f</span><span class="mtk14">}</span><span class="mtk5">"</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk10">f</span><span class="mtk5">"Recall&nbsp;&nbsp;&nbsp;:&nbsp;</span><span class="mtk14">{</span><span class="mtk1">cnn_recall</span><span class="mtk6">:.4f</span><span class="mtk14">}</span><span class="mtk5">"</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk10">f</span><span class="mtk5">"F1&nbsp;Score&nbsp;:&nbsp;</span><span class="mtk14">{</span><span class="mtk1">cnn_f1</span><span class="mtk6">:.4f</span><span class="mtk14">}</span><span class="mtk5">"</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk10">f</span><span class="mtk5">"ROC-AUC&nbsp;&nbsp;:&nbsp;</span><span class="mtk14">{</span><span class="mtk1">cnn_auc</span><span class="mtk6">:.4f</span><span class="mtk14">}</span><span class="mtk5">"</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"\nConfusion&nbsp;Matrix:"</span><span class="mtk14">)</span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk1">cnn_cm</span><span class="mtk14">)</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowrootmode="open"><!----><div><!--?lit$807402273$-->Start coding or <span tabindex="0" role="button" class="link">generate</span> with AI.</div></template></colab-read-only-cell-placeholder></pre></div><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>
